{
  "name": "dsh-plugin-coding-kit",
  "version": "0.1.0",
  "description": "A dsh agent preset plugin: a tuned coding-agent system prompt that replaces the harness persona and identity line — leaving every tool, tool guardrail and plan-mode section untouched — plus a durable three-scope memory system, which the harness has no equivalent of.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./install-preset": {
      "default": "./lib/install-preset.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./persona": {
      "default": "./lib/persona.js"
    },
    "./package.json": "./package.json",
    "./host": {
      "default": "./lib/host.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./lane-projection": {
      "default": "./lib/lane-projection.mjs"
    }
  },
  "files": [
    "lib",
    "preset",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  }
}
